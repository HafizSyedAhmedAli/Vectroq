generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id              String       @id @default(cuid())
  name            String
  contact         String
  city            String
  model           Int
  category        String
  source          String       @default("FORM")
  // Requirements captured on the homepage intake form
  houseType       String       @default("House")
  floors          Int?
  bedrooms        Int?
  plotSizeSqYd    Float?
  coveredAreaSqFt Float?
  budgetRange     String?
  timeline        String?
  additionalNotes String?
  planFileUrl     String?
  planFileName    String?
  consent         Boolean      @default(false)
  createdAt       DateTime     @default(now())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  projects        Project[]

  @@index([organizationId])
}

// Team members work against a Project once a Lead's meeting has happened.
// Kept separate from Lead (rather than adding these fields to Lead directly)
// because a Lead can exist with no Project yet — a Project is created when
// the team follows up.
model Project {
  id             String        @id @default(cuid())
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id])
  model          Int
  category       String
  city           String
  // NEW -> CAD_UPLOADED -> FINALIZED. Deliberately a plain string, not a
  // Prisma enum, so the team can move a project backward (e.g. re-upload
  // after a bad DXF) without a migration.
  status         String        @default("NEW")
  meetingNotes   String?
  cadFile        CadFile?
  render         Render?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  shareToken     String?       @unique
  shareExpiresAt DateTime?

  @@index([organizationId])
}

// One uploaded CAD file per project, holding the geometry parseDxfToGeometry
// extracted. `geometry` and `boq` are stored as JSON rather than normalized
// Room/Wall/Opening/BOQLineItem tables — same flat-JSON tradeoff the
// /api/leads route already makes for `estimate`. Revisit if the team ever
// needs to query across projects by room type or line-item, rather than just
// loading one project's full geometry for review.
model CadFile {
  id         String   @id @default(cuid())
  projectId  String   @unique
  project    Project  @relation(fields: [projectId], references: [id])
  fileName   String
  format     String   @default("dxf") // dwg->dxf conversion is not implemented yet — see cad-upload route
  geometry   Json // Geometry shape from @vectroq/shared-types, correctable by the team
  boq        Json? // BOQResult once finalized; null until then
  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// One presentation render per project, generated independently from the BOQ
// pipeline (CadFile.boq) — the 3D render must never be used to derive
// quantities, only shown to the team/client. This record simply won't exist
// yet if generation failed or hasn't been tried; that must never block
// CadFile.boq from being finalized.
model Render {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id])
  // Served from apps/web/public/renders for now (see the render route) —
  // swap for real object storage (S3/Vercel Blob/etc) before this
  // needs to survive a redeploy or scale past one server.
  imageUrl    String
  promptUsed  String
  generatedAt DateTime @default(now())
}

// Rate cards that the team reviews and approves. A BOQ only
// ever reads APPROVED rows, so totals stay stable and reviewable.
// status is a plain string like Project.status: DRAFT | APPROVED | REJECTED | SUPERSEDED
model RateSet {
  id             String        @id @default(cuid())
  city           String
  category       String
  status         String        @default("DRAFT")
  origin         String        @default("manual") // manual | csr
  taxPercent     Float         @default(17)
  items          Json // RateCardItem[]
  sources        Json? // [{ itemType, sourceUrl, sourceDate, note }] from the AI refresh
  createdAt      DateTime      @default(now())
  approvedAt     DateTime?
  approvedBy     String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@index([organizationId, city, category, status])
}

model Organization {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  tagline      String?
  logoUrl      String?
  primaryColor String    @default("#2563EB")
  phone        String?
  email        String?
  website      String?
  offices      Json      @default("[]") // [{ title, address }]
  rules        Json?
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?
  plan                 String    @default("FREE") // FREE | PRO | BUSINESS
  planStatus           String? // Stripe subscription status
  planRenewsAt         DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  leads        Lead[]
  projects     Project[]
  rateSets     RateSet[]

  memberships Membership[]
  invitations Invitation[]
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  passwordHash       String
  emailVerifiedAt    DateTime?
  createdAt          DateTime            @default(now())
  memberships        Membership[]
  sessions           Session[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String // OWNER | ESTIMATOR | VIEWER
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id             String   @id // sha256 of the cookie token
  userId         String
  organizationId String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
